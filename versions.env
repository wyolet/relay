# Release bill-of-materials (BOM) — the pinned set of companion artifacts the
# relay image bundles. Bump an entry here to ship a new UI/catalog with the next
# relay release. relay's own version is its git tag (the umbrella version); this
# file pins everything relay does NOT build from its own source tree.
#
# Single source of truth, consumed two ways:
#   - Makefile `include`s it (so `make release`/`image` pin the build args).
#   - docker buildx bake receives UI_VERSION + UI_SHA256 + CATALOG_REF +
#     CATALOG_SHA256 from these.
# KEY=value is valid Make-include AND shell-source syntax, so CI/scripts can
# `set -a; . versions.env` to read the same pins.

# relay-ui release tag whose dist tarball is embedded (go:embed) into the image,
# and the sha256 of that tarball, which every fetch verifies before extracting.
# Bump both together with `make ui-pin UI_VERSION=vX.Y.Z`.
UI_VERSION=v0.7.1
UI_SHA256=6585034916384bf8095328c25cc5caf01c30ba1cf447b1bc29613973a18bebd3

# relay-catalog release whose data tarball is bundled + seeded at first boot,
# and the sha256 of that tarball, which the image build verifies before
# extracting. Bump both together with `make catalog-pin CATALOG_VERSION=vX.Y.Z`.
CATALOG_VERSION=v0.1.19
CATALOG_SHA256=e36504a6fc9826b8969da5ac0f0ea066098346892522a661cb726712a4c9d9ab
