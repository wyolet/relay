# Go build settings every relay build and test shares, read by the Makefile,
# the CI scripts and workflows, and the Dockerfile. KEY=value is valid
# Make-include and shell-source syntax.

# encoding/json on the v2 engine: the v1 API with the same results, faster
# decode and encode. Recheck on every Go upgrade. Set it empty to build on the
# classic engine; the allocation pins (make bench-baseline, *_alloc_test.go)
# are measured with it on.
GOEXPERIMENT=jsonv2
