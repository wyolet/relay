{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["* 0-5 * * 1"],
  "timezone": "UTC",
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessageAction": "bump",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "from {{{currentVersion}}} to {{{newVersion}}}",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "minimumReleaseAge": null,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "The sdk and jobq modules are replaced locally and released with relay",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/wyolet/relay/**"],
      "enabled": false
    },
    {
      "description": "One weekly PR for non-major Go module updates past 1.0",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^v?0\\./",
      "groupName": "go non-major"
    },
    {
      "description": "The Go version moves with go.mod on purpose, not with the builder image",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "One weekly PR for container image updates",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "container images"
    },
    {
      "description": "One weekly PR for workflow action updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
