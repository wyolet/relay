{
  "model": "claude-sonnet-4-5",
  "system": [
    {
      "cache_control": {
        "ttl": "1h",
        "type": "ephemeral"
      },
      "text": "You answer questions about the attached handbook.",
      "type": "text"
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "cache_control": {
            "ttl": "1h",
            "type": "ephemeral"
          },
          "text": "What is the leave policy?",
          "type": "text"
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "lookup",
      "description": "Look a section up.",
      "input_schema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          }
        }
      },
      "cache_control": {
        "ttl": "1h",
        "type": "ephemeral"
      }
    }
  ],
  "max_tokens": 1024
}
