{
  "model": "claude-sonnet-4-5",
  "max_tokens": 1024,
  "system": [
    {"type": "text", "text": "You answer questions about the attached handbook.", "cache_control": {"type": "ephemeral", "ttl": "1h"}}
  ],
  "tools": [
    {
      "name": "lookup",
      "description": "Look a section up.",
      "input_schema": {"type": "object", "properties": {"q": {"type": "string"}}},
      "cache_control": {"type": "ephemeral"}
    }
  ],
  "messages": [
    {"role": "user", "content": [{"type": "text", "text": "What is the leave policy?", "cache_control": {"type": "ephemeral"}}]}
  ]
}
