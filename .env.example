# wyolet relay — example env. Copy to `.env` and fill in.
#
# Two modes:
#  (a) STANDALONE MODE (default) — `docker compose up` (no -f) auto-loads
#      override.yml, which bundles its own Postgres/ClickHouse/Valkey/Jaeger.
#      The DSNs below point at those bundled services.
#  (b) EXTERNAL MODE — point the DSNs at your own managed PG/CH/Redis/OTLP
#      (see the commented block at the bottom).

# -------- core --------
RELAY_CATALOG_BACKEND=pg
RELAY_STATE_BACKEND=redis
RELAY_EVENTLOG_BACKEND=clickhouse
RELAY_CONFIG_DIR=/config
RELAY_ADMIN_TOKEN=admin-token
RELAY_ADMIN_PASSWORD=change-me
# single (default) grants every authenticated caller every action.
# rbac evaluates the caller's RoleBindings against each row's scope.
RELAY_AUTHZ=single
# REQUIRED — master key for encrypting stored credentials (AES-256).
# Generate your OWN; never reuse a value copied from anywhere public:
#   openssl rand -base64 32
RELAY_MASTER_KEY=
RELAY_CLUSTER_MODE=on
# Run pending up-migrations at boot (default on). Set off while rolling the
# schema back with `relay migrate down`, so a restarting pod leaves it alone.
RELAY_MIGRATE_ON_BOOT=on
RELAY_CONTROL_ALLOW_ORIGINS=http://localhost:5100
# Log verbosity: debug|info|warn|error (default info). INFO stays quiet —
# startup summary, errors, warnings only. Set debug for per-request tracing.
RELAY_LOG_LEVEL=info

# -------- admin UI runtime config (GET /config.json) --------
# Public values the admin UI reads at boot from ${origin}/config.json. All
# optional. In the single-binary deployment (UI embedded, one origin) leave
# them unset — the UI falls back to its own origin and the /api prefix.
# Set them when the UI is served from a different hostname than the APIs:
# RELAY_CONTROL_API_URL=https://relay-control.example.com/api   (mind the /api)
# RELAY_INFERENCE_API_URL=https://relay-api.example.com
# RELAY_MODE=oss                       # oss | cloud (default oss)
# RELAY_UI_DOCS_URL=                   # override docs link in the UI shell
# RELAY_UI_SUPPORT_URL=                # override support link
# RELAY_UI_SENTRY_DSN=                 # PUBLIC client-side DSN only
# RELAY_UI_TELEMETRY_ENV=

# -------- ports --------
RELAY_LB_PORT=5100
RELAY_A_PORT=5101
RELAY_B_PORT=5102
RELAY_CONTROL_PORT=5103

# Externally reachable control-plane origin. Exported manifests point their
# `$schema` directive at this host; empty renders it relative.
RELAY_PUBLIC_URL=

# Comma-separated IPs/CIDRs of reverse proxies allowed to set
# X-Forwarded-For. Empty means no proxy is trusted (client IP is always
# RemoteAddr). Only set this to your actual LB/ingress addresses.
# RELAY_TRUSTED_PROXIES=

# Offline license: a path (highest precedence) or the value inline. Both
# win over the stored `license` setting installed via PUT /api/license.
# RELAY_LICENSE_FILE=
# RELAY_LICENSE=

# -------- image --------
# Used by the base compose to PULL a published image. The default standalone
# stack builds from source instead (root docker-compose.override.yml), so this
# is ignored until a published image exists. The image bakes in the catalog and
# auto-seeds it on first boot (RELAY_CATALOG_DIR + RELAY_AUTO_SEED_IF_EMPTY are
# set inside the image — no need to set them here).
RELAY_IMAGE=ghcr.io/wyolet/relay:latest

# -------- catalog version --------
# Pin the seeded catalog to a relay-catalog release ("v0.1.1"), or track the
# newest release for this binary's schema channel with "latest" (alias:
# "auto"). Resolution + reseed happen at boot: the stored marker is compared
# with the concrete version; on mismatch the tree is seeded — from the baked
# /catalog when its .version stamp matches (no network), else fetched.
# Reseeds never clobber operator edits (dirty rows skipped, overlays re-merge).
# Unset = seed-if-empty from RELAY_CATALOG_DIR only.
# RELAY_CATALOG_VERSION=latest
# Archive URL template for fetches ("{version}" substituted) and channel-index
# URL for "latest" resolution — override for mirrors / airgapped setups.
# RELAY_CATALOG_URL=https://github.com/wyolet/relay-catalog/archive/{version}.tar.gz
# RELAY_CATALOG_INDEX_URL=https://raw.githubusercontent.com/wyolet/relay-catalog/main/index.yaml
#
# Self-curated catalog: mount your clone over /catalog (or point
# RELAY_CATALOG_DIR at the volume). To reseed after curating, write your own
# stamp to <dir>/.version (e.g. "my-fork-2") and set RELAY_CATALOG_VERSION to
# the same value — the relay reseeds from the volume on next boot, offline.
# Do NOT combine a custom catalog with RELAY_CATALOG_VERSION=latest: that
# fetches upstream releases over your fork.

# -------- (a) standalone mode (default — bundled services) --------
RELAY_PG_DSN=postgres://relay:relay@postgres:5432/relay?sslmode=disable
RELAY_CH_DSN=clickhouse://relay:relay@clickhouse:9000/relay
RELAY_REDIS_ADDR=valkey:6379
RELAY_OTLP_ENDPOINT=jaeger:4317

# -------- (b) external mode (uncomment + point at your own services) --------
# RELAY_PG_DSN=postgres://USER:PASSWORD@your-postgres-host:5432/relay?sslmode=require
# RELAY_CH_DSN=clickhouse://USER:PASSWORD@your-clickhouse-host:9000/relay
# RELAY_REDIS_ADDR=your-redis-host:6379
# RELAY_OTLP_ENDPOINT=your-otel-collector:4317

# -------- testing --------
OPENAI_KEY_TEST=test-value-1234
LOADTEST_ANON_KEY=fake-anon-1234

# -------- SSO / OIDC login (optional) --------
# WYOLET_AUTH_MODE=oidc enables OpenID Connect login for the admin UI without
# touching the DB-backed auth:oidc settings section (which remains the
# fallback when this is unset). The redirect URL must byte-exactly match a
# redirect URI registered with your identity provider; the conventional shape
# is https://<ui-origin>/auth/callback. Registration defaults to "open"
# (auto-provision a user on first login); set closed to reject unknown
# subjects.
# WYOLET_AUTH_MODE=oidc
# WYOLET_OIDC_ISSUER=https://auth.example.com
# WYOLET_OIDC_CLIENT_ID=your-client-id
# WYOLET_OIDC_CLIENT_SECRET=your-client-secret
# WYOLET_OIDC_REDIRECT_URL=https://relay.example.com/auth/callback
# WYOLET_OIDC_REGISTRATION=open
# Where the browser lands after a successful SSO login. Default "/" (right for
# the embedded UI); set to the UI origin when the UI is served elsewhere:
# WYOLET_OIDC_POST_LOGIN_URL=https://relay.example.com/
